{
    "name": "cycle/orm-promise-mapper",
    "type": "library",
    "description": "Promise mapper for Cycle ORM",
    "require": {
        "php": ">=8.0",
        "cycle/orm": "^2.9",
        "doctrine/instantiator": "^1.3.1 || ^2.0",
        "laminas/laminas-hydrator": "^4.0",
        "symfony/polyfill-php83": "^1.31"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "spiral/code-style": "^2.2",
        "spiral/tokenizer": "^2.12 || ^3.15",
        "vimeo/psalm": "^5.26 || ^6.8"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\Tests\\": "tests/PromiseMapper"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "phpunit --color=always"
    }
}

{
    "name": "cycle/orm-promise-mapper",
    "type": "library",
    "require": {
        "php": ">=8.0",
        "cycle/orm": "^2.9",
        "doctrine/instantiator": "^1.3.1 || ^2.0",
        "laminas/laminas-hydrator": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^5.26 || ^6.8",
        "spiral/tokenizer": "^2.12 || ^3.15"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\Tests\\": "tests/PromiseMapper"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

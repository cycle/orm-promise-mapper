{
    "name": "cycle/orm-promise-mapper",
    "type": "library",
    "description": "Promise mapper for Cycle ORM",
    "require": {
        "php": ">=8.2",
        "cycle/orm": "^2.18",
        "doctrine/instantiator": "^2.0",
        "laminas/laminas-hydrator": "^4.19 || ^5.0",
        "symfony/polyfill-php83": "^1.33"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.20",
        "cycle/testing": "1.x-dev",
        "llm/skills": "^1.20",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5",
        "roxblnfk/unpoly": "^1.8",
        "spiral/tokenizer": "^3.18",
        "testo/bridge-mockery": "^0.1.2",
        "testo/bridge-rector": "^0.3.6",
        "testo/testo": "^0.10.60"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cycle\\ORM\\PromiseMapper\\Tests\\": "tests/PromiseMapper"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../testing",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "phpunit --color=always"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        }
    }
}
